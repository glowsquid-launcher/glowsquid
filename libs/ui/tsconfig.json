{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "Bundler"
	},
	"references": [
		{
			"path": "../eslint-config"
		}
	],
	"include": ["../eslint-config/**/*"]
}
